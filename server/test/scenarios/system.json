{
 "name": "system",
 "steps": [
  {
   "name": "현황 — 처음 (쓰기 전)",
   "method": "GET",
   "path": "/api/system"
  },
  {
   "name": "스토리지 확인 — 미설정",
   "method": "GET",
   "path": "/api/system/storage/check"
  },
  {
   "name": "설정 — 처음 (부팅 설정의 빈 문자열)",
   "method": "GET",
   "path": "/api/system/settings"
  },
  {
   "name": "하루 한도 — 숫자 아님",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {
    "dailyChars": "abc"
   }
  },
  {
   "name": "하루 한도 — 0",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {
    "dailyChars": "0"
   }
  },
  {
   "name": "하루 한도 — 음수",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {
    "dailyChars": "-5"
   }
  },
  {
   "name": "하루 한도 — 월 한도 초과",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {
    "dailyChars": "450001"
   }
  },
  {
   "name": "하루 한도 — long 범위 밖",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {
    "dailyChars": "99999999999999999999"
   }
  },
  {
   "name": "하루 한도 — 소수",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {
    "dailyChars": "10.5"
   }
  },
  {
   "name": "하루 한도 — 깨진 JSON",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "rawBody": "{"
  },
  {
   "name": "하루 한도 — 빈 본문",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "rawBody": ""
  },
  {
   "name": "하루 한도 — 필드 없음은 지우기",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {}
  },
  {
   "name": "현황 — 하루 한도 없음",
   "method": "GET",
   "path": "/api/system"
  },
  {
   "name": "하루 한도 — 공백·부호 (정규화해서 저장)",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {
    "dailyChars": "  +5000 "
   }
  },
  {
   "name": "하루 한도 — 숫자로 보냄",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {
    "dailyChars": 7000
   }
  },
  {
   "name": "하루 한도 — 같은 값 다시 (updated_at 그대로)",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "body": {
    "dailyChars": "7000"
   }
  },
  {
   "name": "현황 — 하루 한도 7000",
   "method": "GET",
   "path": "/api/system"
  },
  {
   "name": "IGDB 키 저장 — 앞뒤 공백",
   "method": "PUT",
   "path": "/api/system/settings/igdb",
   "body": {
    "clientId": " abc ",
    "clientSecret": " def "
   }
  },
  {
   "name": "설정 — 저장한 키",
   "method": "GET",
   "path": "/api/system/settings"
  },
  {
   "name": "설정 원문 — 눈 버튼 (가리지 않은 값)",
   "method": "POST",
   "path": "/api/system/settings/reveal"
  },
  {
   "name": "IGDB 키 저장 — 가린 값을 그대로 돌려보냄 (원문 유지)",
   "method": "PUT",
   "path": "/api/system/settings/igdb",
   "body": {
    "clientId": "abc",
    "clientSecret": "••••"
   }
  },
  {
   "name": "설정 원문 — 가린 값으로 덮이지 않았다",
   "method": "POST",
   "path": "/api/system/settings/reveal"
  },
  {
   "name": "IGDB 키 저장 — 긴 시크릿",
   "method": "PUT",
   "path": "/api/system/settings/igdb",
   "body": {
    "clientId": "abc",
    "clientSecret": "secret-long-123456"
   }
  },
  {
   "name": "설정 — 긴 시크릿은 끝 4자리만",
   "method": "GET",
   "path": "/api/system/settings"
  },
  {
   "name": "IGDB 연결 테스트 — 가린 값이면 저장된 원문으로 시험",
   "method": "POST",
   "path": "/api/system/settings/igdb/test",
   "body": {
    "clientId": "abc",
    "clientSecret": "••••3456"
   },
   "note": "가짜 키라 Twitch가 거절한다 — 응답 모양만 본다"
  },
  {
   "name": "IGDB 키 저장 — 가린 끝 4자리 그대로 (원문 유지)",
   "method": "PUT",
   "path": "/api/system/settings/igdb",
   "body": {
    "clientId": "abc",
    "clientSecret": "••••3456"
   }
  },
  {
   "name": "설정 원문 — 긴 시크릿 그대로",
   "method": "POST",
   "path": "/api/system/settings/reveal"
  },
  {
   "name": "IGDB 키 저장 — 원래 값으로 되돌림",
   "method": "PUT",
   "path": "/api/system/settings/igdb",
   "body": {
    "clientId": " abc ",
    "clientSecret": " def "
   }
  },
  {
   "name": "IGDB 키 저장 — 시크릿 없음 (400, 아무것도 저장 안 함 — 고친 버그 7)",
   "method": "PUT",
   "path": "/api/system/settings/igdb",
   "body": {
    "clientId": "x2"
   }
  },
  {
   "name": "설정 — 그대로 (ID만 저장되지 않았다)",
   "method": "GET",
   "path": "/api/system/settings"
  },
  {
   "name": "IGDB 키 저장 — 둘 다 없음 (400)",
   "method": "PUT",
   "path": "/api/system/settings/igdb",
   "body": {}
  },
  {
   "name": "IGDB 키 저장 — 깨진 JSON",
   "method": "PUT",
   "path": "/api/system/settings/igdb",
   "rawBody": "{\"clientId\":"
  },
  {
   "name": "검색 — 가짜 키로 Twitch가 거절 → 502",
   "method": "GET",
   "path": "/api/games?q=hollow"
  },
  {
   "name": "재동기화 — 가짜 키 → 502",
   "method": "POST",
   "path": "/api/games/2/resync"
  },
  {
   "name": "현황 — IGDB 호출 기록 없음 (토큰 단계에서 끝남)",
   "method": "GET",
   "path": "/api/system"
  },
  {
   "name": "IGDB 키 저장 — 공백만 (빈 값 저장, 부팅 설정으로 떨어짐)",
   "method": "PUT",
   "path": "/api/system/settings/igdb",
   "body": {
    "clientId": "   ",
    "clientSecret": "   "
   }
  },
  {
   "name": "설정 — 키 칸은 있지만 비어 부팅 설정",
   "method": "GET",
   "path": "/api/system/settings"
  },
  {
   "name": "번역 키 저장 — 없음 (400)",
   "method": "PUT",
   "path": "/api/system/settings/translate",
   "body": {}
  },
  {
   "name": "번역 키 저장 — 공백만 (빈 값)",
   "method": "PUT",
   "path": "/api/system/settings/translate",
   "body": {
    "apiKey": "   "
   }
  },
  {
   "name": "설정 — 번역 키 없음",
   "method": "GET",
   "path": "/api/system/settings"
  },
  {
   "name": "번역 키 저장",
   "method": "PUT",
   "path": "/api/system/settings/translate",
   "body": {
    "apiKey": " fake-key "
   }
  },
  {
   "name": "설정 — 번역 키",
   "method": "GET",
   "path": "/api/system/settings"
  },
  {
   "name": "번역 키 확인 — 없음",
   "method": "POST",
   "path": "/api/system/settings/translate/test",
   "body": {}
  },
  {
   "name": "번역 키 확인 — 공백",
   "method": "POST",
   "path": "/api/system/settings/translate/test",
   "body": {
    "apiKey": "  "
   }
  },
  {
   "name": "번역 키 확인 — 가짜 키 (구글 400)",
   "method": "POST",
   "path": "/api/system/settings/translate/test",
   "body": {
    "apiKey": "invalid-key-for-test"
   },
   "note": "구글을 실제로 부른다. 가짜 키라 글자도 안 쓰고 400이 온다"
  },
  {
   "name": "번역 키 확인 — 깨진 JSON",
   "method": "POST",
   "path": "/api/system/settings/translate/test",
   "rawBody": "["
  },
  {
   "name": "IGDB 확인 — 비어 있음",
   "method": "POST",
   "path": "/api/system/settings/igdb/test",
   "body": {
    "clientId": "",
    "clientSecret": "x"
   }
  },
  {
   "name": "IGDB 확인 — 가짜 키 (Twitch 거절)",
   "method": "POST",
   "path": "/api/system/settings/igdb/test",
   "body": {
    "clientId": "fake-id",
    "clientSecret": "fake-secret"
   },
   "note": "Twitch를 실제로 부른다. 가짜 키라 400"
  },
  {
   "name": "IGDB 확인 — 깨진 JSON",
   "method": "POST",
   "path": "/api/system/settings/igdb/test",
   "rawBody": "x"
  },
  {
   "name": "현황 — 끝",
   "method": "GET",
   "path": "/api/system"
  },
  {
   "name": "토큰 — 없음 (401)",
   "method": "GET",
   "path": "/api/system",
   "auth": "none"
  },
  {
   "name": "토큰 — 틀림 (401)",
   "method": "GET",
   "path": "/api/system",
   "auth": "wrong"
  },
  {
   "name": "토큰 — 쿼리 t= (GET은 받는다, 미디어용)",
   "method": "GET",
   "path": "/api/system",
   "auth": "query"
  },
  {
   "name": "토큰 — 쿼리 t=는 POST에 안 먹는다 (401)",
   "method": "POST",
   "path": "/api/system/settings/reveal",
   "auth": "query"
  },
  {
   "name": "토큰 — 없으면 원문도 없다 (401)",
   "method": "POST",
   "path": "/api/system/settings/reveal",
   "auth": "none"
  },
  {
   "name": "출처 — 남의 출처 (403)",
   "method": "GET",
   "path": "/api/system",
   "headers": {
    "Origin": "http://evil.example"
   }
  },
  {
   "name": "출처 — 남의 출처 사전 요청 (403)",
   "method": "PATCH",
   "path": "/api/system",
   "headers": {
    "Origin": "http://127.0.0.1:1"
   }
  },
  {
   "name": "본문 — text/plain PUT (415, 단순 요청 CSRF)",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "rawBody": "{\"dailyChars\":\"1\"}",
   "headers": {
    "Content-Type": "text/plain"
   }
  },
  {
   "name": "본문 — 폼 POST (415)",
   "method": "POST",
   "path": "/api/system/settings/igdb/test",
   "rawBody": "clientId=a&clientSecret=b",
   "headers": {
    "Content-Type": "application/x-www-form-urlencoded"
   }
  },
  {
   "name": "본문 — 형식 없는 본문 (415)",
   "method": "PUT",
   "path": "/api/system/settings/translate/daily-limit",
   "rawBody": "{\"dailyChars\":\"1\"}",
   "headers": {
    "Content-Type": ""
   }
  },
  {
   "name": "현황 — 거절된 쓰기는 아무것도 안 바꿨다",
   "method": "GET",
   "path": "/api/system"
  }
 ]
}
