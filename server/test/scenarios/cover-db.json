{
 "name": "cover-db",
 "note": "커버 DB 저장 (V17) — 기본 위치, 올리기·읽기·교체·지우기, 형식 6 내보내기 왕복. 그림 파일은 backlog-media 것을 쓴다",
 "fixture": "fresh",
 "steps": [
  {
   "name": "준비 — 수동 게임 A",
   "method": "POST",
   "path": "/api/games",
   "body": {
    "name": "ZZ Cover A",
    "releasedOn": "2024-01-02"
   },
   "save": {
    "ga": "id"
   }
  },
  {
   "name": "준비 — 수동 게임 B",
   "method": "POST",
   "path": "/api/games",
   "body": {
    "name": "ZZ Cover B",
    "releasedOn": "2024-01-03"
   },
   "save": {
    "gb": "id"
   }
  },
  {
   "name": "준비 — 담기 A",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "gameId": "${ga}"
   },
   "save": {
    "ea": "id"
   }
  },
  {
   "name": "준비 — 담기 B",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "gameId": "${gb}"
   },
   "save": {
    "eb": "id"
   }
  },
  {
   "name": "허가증 — 기본은 DB (자격증명도 설정도 없음)",
   "method": "POST",
   "path": "/api/backlog/${ea}/cover/upload-url",
   "body": {
    "fileName": "cover.png",
    "sizeBytes": 73
   }
  },
  {
   "name": "허가증 — 너무 큼 (DB도 5MB)",
   "method": "POST",
   "path": "/api/backlog/${ea}/cover/upload-url",
   "body": {
    "fileName": "a.jpg",
    "sizeBytes": 5242881
   }
  },
  {
   "name": "올리기 A — 아직 커버 없음",
   "method": "GET",
   "path": "/api/backlog/${ea}/cover/file?v=x"
  },
  {
   "name": "올리기 A — 가짜 PNG (매직 넘버)",
   "method": "POST",
   "path": "/api/backlog/${ea}/cover/file",
   "multipart": {
    "file": {
     "file": "backlog-media/fake.png",
     "type": "image/png"
    }
   }
  },
  {
   "name": "올리기 A — 빈 파일",
   "method": "POST",
   "path": "/api/backlog/${ea}/cover/file",
   "multipart": {
    "file": {
     "file": "backlog-media/empty.png",
     "type": "image/png"
    }
   }
  },
  {
   "name": "올리기 A — DB에 저장",
   "method": "POST",
   "path": "/api/backlog/${ea}/cover/file",
   "multipart": {
    "file": {
     "file": "backlog-media/cover.png",
     "type": "image/png"
    }
   }
  },
  {
   "name": "읽기 A — 바이트가 올린 것과 같다",
   "method": "GET",
   "path": "/api/backlog/${ea}/cover/file?v=x"
  },
  {
   "name": "상세 A — 개인 커버 주소 (?v=이름)",
   "method": "GET",
   "path": "/api/backlog/${ea}"
  },
  {
   "name": "올리기 B — DB에 저장",
   "method": "POST",
   "path": "/api/backlog/${eb}/cover/file",
   "multipart": {
    "file": {
     "file": "backlog-media/cover.png",
     "type": "image/png"
    }
   }
  },
  {
   "name": "올리기 B — 교체 (다른 이미지)",
   "method": "POST",
   "path": "/api/backlog/${eb}/cover/file",
   "multipart": {
    "file": {
     "file": "backlog-media/cover2.png",
     "type": "image/png"
    }
   }
  },
  {
   "name": "읽기 B — 교체한 바이트",
   "method": "GET",
   "path": "/api/backlog/${eb}/cover/file?v=x"
  },
  {
   "name": "카드 — 커버 주소",
   "method": "GET",
   "path": "/api/backlog/cards"
  },
  {
   "name": "지우기 A",
   "method": "DELETE",
   "path": "/api/backlog/${ea}/cover"
  },
  {
   "name": "지우기 A — 다시 (없어도 204)",
   "method": "DELETE",
   "path": "/api/backlog/${ea}/cover"
  },
  {
   "name": "읽기 A — 지운 뒤",
   "method": "GET",
   "path": "/api/backlog/${ea}/cover/file?v=x"
  },
  {
   "name": "상세 A — 마스터 커버로 폴백",
   "method": "GET",
   "path": "/api/backlog/${ea}"
  },
  {
   "name": "내보내기 — 형식 6, B 커버 바이트 실림",
   "method": "GET",
   "path": "/api/me/export",
   "save": {
    "fv": "formatVersion",
    "exAt": "exportedAt",
    "prof": "profile",
    "cat": "catalog",
    "games": "games",
    "entries": "entries"
   }
  },
  {
   "name": "덮어쓰기 — 내보낸 것 그대로 (왕복)",
   "method": "POST",
   "path": "/api/me/replace",
   "body": {
    "formatVersion": "${fv}",
    "exportedAt": "${exAt}",
    "profile": "${prof}",
    "catalog": "${cat}",
    "games": "${games}",
    "entries": "${entries}"
   }
  },
  {
   "name": "왕복 뒤 — 내보내기 (처음 것과 같아야 한다)",
   "method": "GET",
   "path": "/api/me/export"
  },
  {
   "name": "왕복 뒤 — 카드 (B만 개인 커버)",
   "method": "GET",
   "path": "/api/backlog/cards"
  },
  {
   "name": "왕복 뒤 — 읽기 B (바이트가 교체한 그대로)",
   "method": "GET",
   "path": "/api/backlog/4/cover/file?v=x",
   "note": "빈 세이브라 항목 번호가 고정이다 — 덮어쓰기가 A·B를 3·4로 다시 만든다"
  },
