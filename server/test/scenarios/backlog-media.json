{
 "name": "backlog-media",
 "note": "커버는 LOCAL(데이터 루트 covers/) 경로를 본다 — 기본(DB)은 cover-db 시나리오",
 "env": {
  "STARLOG_COVER_TARGET": "local"
 },
 "steps": [
  {
   "name": "담기 — 수동 게임 만들기",
   "method": "POST",
   "path": "/api/games",
   "body": {
    "name": "Backlog Test Game",
    "releasedOn": "2024-01-02"
   },
   "save": {
    "gid": "id"
   }
  },
  {
   "name": "담기 — 새 게임",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "gameId": "${gid}"
   },
   "save": {
    "newEntry": "id"
   }
  },
  {
   "name": "담기 — 이미 담음",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "gameId": "${gid}"
   }
  },
  {
   "name": "담기 — 실데이터 게임 (이미 담음)",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "gameId": 2
   }
  },
  {
   "name": "담기 — 캐시된 externalId (이미 담음)",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "externalId": " 40477 "
   }
  },
  {
   "name": "담기 — 캐시된 externalId 앞에 0 (같은 게임으로 찾는다 — 고친 버그 12)",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "externalId": "040477"
   },
   "note": "예전엔 캐시를 못 찾고 IGDB로 갔다(여기선 미설정 502, 실제론 저장에서 409)"
  },
  {
   "name": "담기 — 둘 다 없음",
   "method": "POST",
   "path": "/api/backlog",
   "body": {}
  },
  {
   "name": "담기 — externalId 공백",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "externalId": "   "
   }
  },
  {
   "name": "담기 — 없는 게임",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "gameId": 999999
   }
  },
  {
   "name": "담기 — gameId 형식 오류",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "gameId": "abc"
   }
  },
  {
   "name": "담기 — 캐시 안 된 externalId (IGDB 미설정)",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "externalId": "999999999"
   }
  },
  {
   "name": "담기 — 삭제 준비",
   "method": "DELETE",
   "path": "/api/backlog/86"
  },
  {
   "name": "담기 — 삭제된 항목이 있음 (되살리기 제안)",
   "method": "POST",
   "path": "/api/backlog",
   "body": {
    "gameId": 7
   }
  },
  {
   "name": "담기 — 새 항목 상세",
   "method": "GET",
   "path": "/api/backlog/${newEntry}"
  },
  {
   "name": "커버 허가증 — LOCAL",
   "method": "POST",
   "path": "/api/backlog/81/cover/upload-url",
   "body": {
    "fileName": "cover.png",
    "sizeBytes": 73
   }
  },
  {
   "name": "커버 허가증 — 대문자 확장자·공백",
   "method": "POST",
   "path": "/api/backlog/81/cover/upload-url",
   "body": {
    "fileName": "  My Cover.JPEG ",
    "sizeBytes": 5242880
   }
  },
  {
   "name": "커버 허가증 — 이름 없음",
   "method": "POST",
   "path": "/api/backlog/81/cover/upload-url",
   "body": {
    "fileName": "  ",
    "sizeBytes": 10
   }
  },
  {
   "name": "커버 허가증 — 크기 0",
   "method": "POST",
   "path": "/api/backlog/81/cover/upload-url",
   "body": {
    "fileName": "a.png",
    "sizeBytes": 0
   }
  },
  {
   "name": "커버 허가증 — 크기 없음 (원시형)",
   "method": "POST",
   "path": "/api/backlog/81/cover/upload-url",
   "body": {
    "fileName": "a.png"
   }
  },
  {
   "name": "커버 허가증 — 크기 null",
   "method": "POST",
   "path": "/api/backlog/81/cover/upload-url",
   "body": {
    "fileName": "a.png",
    "sizeBytes": null
   }
  },
  {
   "name": "커버 허가증 — 너무 큼",
   "method": "POST",
   "path": "/api/backlog/81/cover/upload-url",
   "body": {
    "fileName": "a.png",
    "sizeBytes": 5242881
   }
  },
  {
   "name": "커버 허가증 — 형식",
   "method": "POST",
   "path": "/api/backlog/81/cover/upload-url",
   "body": {
    "fileName": "a.gif",
    "sizeBytes": 10
   }
  },
  {
   "name": "커버 허가증 — 확장자 없음",
   "method": "POST",
   "path": "/api/backlog/81/cover/upload-url",
   "body": {
    "fileName": "cover.",
    "sizeBytes": 10
   }
  },
  {
   "name": "커버 허가증 — 없는 항목 (형식보다 먼저)",
   "method": "POST",
   "path": "/api/backlog/999999/cover/upload-url",
   "body": {
    "fileName": "a.gif",
    "sizeBytes": 10
   }
  },
  {
   "name": "커버 확정 — key 없음",
   "method": "PUT",
   "path": "/api/backlog/81/cover",
   "body": {
    "storageKey": " "
   }
  },
  {
   "name": "커버 확정 — 다른 항목의 경로",
   "method": "PUT",
   "path": "/api/backlog/81/cover",
   "body": {
    "storageKey": "covers/entry-82/x.png"
   }
  },
  {
   "name": "커버 확정 — 경로 우회 (..로 다른 항목의 키를 가리킴)",
   "method": "PUT",
   "path": "/api/backlog/81/cover",
   "body": {
    "storageKey": "covers/entry-81/../entry-82/0f8e9a1c-3b4d-4e5f-8a6b-7c8d9e0f1a2b.png"
   }
  },
  {
   "name": "커버 확정 — 모양이 uuid가 아님",
   "method": "PUT",
   "path": "/api/backlog/81/cover",
   "body": {
    "storageKey": "covers/entry-81/x.png"
   }
  },
  {
   "name": "커버 확정 — V14 전 경로 모양 (covers/<회원>/<항목>/)",
   "method": "PUT",
   "path": "/api/backlog/81/cover",
   "body": {
    "storageKey": "covers/1/81/x.png"
   }
  },
  {
   "name": "커버 확정 — 스토리지 미설정 (502)",
   "method": "PUT",
   "path": "/api/backlog/81/cover",
   "body": {
    "storageKey": "  covers/entry-81/0f8e9a1c-3b4d-4e5f-8a6b-7c8d9e0f1a2b.png "
   }
  },
  {
   "name": "커버 확정 — 없는 항목",
   "method": "PUT",
   "path": "/api/backlog/999999/cover",
   "body": {
    "storageKey": "covers/entry-999999/0f8e9a1c-3b4d-4e5f-8a6b-7c8d9e0f1a2b.png"
   }
  },
  {
   "name": "커버 올리기 — LOCAL",
   "method": "POST",
   "path": "/api/backlog/81/cover/file",
   "multipart": {
    "file": {
     "file": "backlog-media/cover.png"
    }
   }
  },
  {
   "name": "커버 원본",
   "method": "GET",
   "path": "/api/backlog/81/cover/file?v=x"
  },
  {
   "name": "커버 — 상세에 반영",
   "method": "GET",
   "path": "/api/backlog/81",
   "ignore": [
    "resolved.cover.url"
   ],
   "note": "LOCAL 커버 파일명은 uuid라 양쪽이 다르다 — 주소만 무시하고, 바이트는 GET cover/file로 대조한다"
  },
  {
   "name": "커버 — 목록에 반영",
   "method": "GET",
   "path": "/api/backlog?q=%EC%8A%AC%EB%A0%88%EC%9D%B4",
   "ignore": [
    "items.*.coverUrl"
   ],
   "note": "LOCAL 커버 파일명은 uuid라 양쪽이 다르다 — 주소만 무시하고, 바이트는 GET cover/file로 대조한다"
  },
  {
   "name": "커버 올리기 — 교체",
   "method": "POST",
   "path": "/api/backlog/81/cover/file",
   "multipart": {
    "file": {
     "file": "backlog-media/cover2.png",
     "filename": "cover two.PNG"
    }
   }
  },
  {
   "name": "커버 원본 — 교체 뒤",
   "method": "GET",
   "path": "/api/backlog/81/cover/file"
  },
  {
