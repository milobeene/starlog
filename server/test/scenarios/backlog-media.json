   "method": "POST",
   "path": "/api/backlog/81/cover/file",
   "multipart": {
    "other": "x"
   }
  },
  {
   "name": "커버 올리기 — 없는 항목",
   "method": "POST",
   "path": "/api/backlog/999999/cover/file",
   "multipart": {
    "file": {
     "file": "backlog-media/cover.png"
    }
   }
  },
  {
   "name": "커버 원본 — 커버 없음",
   "method": "GET",
   "path": "/api/backlog/83/cover/file"
  },
  {
   "name": "커버 원본 — EXTERNAL 커버",
   "method": "GET",
   "path": "/api/backlog/88/cover/file"
  },
  {
   "name": "커버 원본 — 없는 항목",
