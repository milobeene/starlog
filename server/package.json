{
  "name": "starlog-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "gen": "tsx scripts/gen-migrations.ts",
    "typecheck": "tsx scripts/gen-migrations.ts && tsc --noEmit -p .",
    "test": "vitest run",
    "test:golden": "node scripts/golden-all.mjs",
    "bundle": "tsx scripts/gen-migrations.ts && node scripts/bundle.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@hono/node-server": "^2.1.5",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.14",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
